<Window x:Class="Bookkeeping.Wpf.Views.SponsorDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:converters="clr-namespace:Bookkeeping.Wpf.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="680" Width="820"
        MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"
                       Foreground="#2c3e50" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✕ Close" Width="80" Height="32"
                    Background="#e74c3c" Foreground="White" FontWeight="SemiBold"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

        <!-- Contact info -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10,8"
                Margin="0,0,0,8"
                Visibility="{Binding HasContactInfo, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,16,0" FontSize="12" Foreground="#555"
                           Visibility="{Binding Email, Converter={StaticResource StringToVisibilityConverter}}">
                    📧 <Run Text="{Binding Email}"/>
                </TextBlock>
                <TextBlock Margin="0,0,16,0" FontSize="12" Foreground="#555"
                           Visibility="{Binding Phone, Converter={StaticResource StringToVisibilityConverter}}">
                    📞 <Run Text="{Binding Phone}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#555"
                           Visibility="{Binding Address, Converter={StaticResource StringToVisibilityConverter}}">
                    📍 <Run Text="{Binding Address}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Period toggle -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Period:" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="#555" Margin="0,0,10,0"/>
            <Button Content="Current Month" Width="120" Height="30"
                    Command="{Binding ToggleMonthCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#ecf0f1"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCurrentMonth}" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Current Year" Width="120" Height="30" Margin="5,0,0,0"
                    Command="{Binding ToggleYearCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#ecf0f1"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCurrentMonth}" Value="False">
                                <Setter Property="Background" Value="#2980b9"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Chart + summary -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="8,8,0,0"
                    Padding="10,10,10,0">
                <oxy:PlotView Model="{Binding ChartModel}"/>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="0,0,8,8"
                    Padding="10,5,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#27ae60" CornerRadius="6" Padding="10,5"
                            Width="170" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="DONATED" Foreground="White" FontSize="9"
                                       Opacity="0.8" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalDonated, StringFormat={}{0:C}}"
                                       Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2980b9" CornerRadius="6" Padding="10,5" Width="170">
                        <StackPanel>
                            <TextBlock Text="TARGETS" Foreground="White" FontSize="9"
                                       Opacity="0.8" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalTargets, StringFormat={}{0:C}}"
                                       Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Target progress -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="10"
                Margin="0,0,0,8"
                Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Targets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding ProgramName}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#2c3e50"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding ProgressColor}"
                                       VerticalAlignment="Center" Margin="0,0,0,2"/>

                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,2,0,0">
                                <Border Height="14" CornerRadius="7" Background="#ecf0f1"/>
                                <Border Height="14" CornerRadius="7"
                                        HorizontalAlignment="Left"
                                        Background="{Binding ProgressColor}"
                                        Width="{Binding ProgressBarWidth}"/>
                                <TextBlock Text="{Binding ProgressLabel}" FontSize="9"
                                           Foreground="#555" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Donation history -->
        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Donation History" FontSize="16" FontWeight="SemiBold"
                               Foreground="#2c3e50" Margin="0,0,0,4"/>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMoreDonations}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="⚠ Showing most recent 500 donations. Totals include the full period."
                             Foreground="#e67e22" FontSize="11"/>
                        <Run Text=" Use Reports for full history."
                             Foreground="#888" FontSize="11"/>
                    </TextBlock>
                </StackPanel>

                <ListView Grid.Row="1" ItemsSource="{Binding Donations}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Date" Width="95"
                                DisplayMemberBinding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"/>
                            <GridViewColumn Header="Program" Width="150"
                                DisplayMemberBinding="{Binding ProgramName}"/>
                            <GridViewColumn Header="Method" Width="90"
                                DisplayMemberBinding="{Binding PaymentMethod}"/>
                            <GridViewColumn Header="Receipt #" Width="100"
                                DisplayMemberBinding="{Binding ReceiptNumber}"/>
                            <GridViewColumn Header="Amount" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayAmount}"
                                                   Foreground="{Binding AmountColor, Converter={StaticResource StringToBrushConverter}}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>

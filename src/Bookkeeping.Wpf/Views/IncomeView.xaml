<UserControl x:Class="Bookkeeping.Wpf.Views.IncomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Bookkeeping.Wpf.Converters"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Revenue / Donations" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="+ Record Donation" Width="140" Background="#27ae60" Foreground="White"
                    FontWeight="SemiBold" Margin="20,0,0,0" Command="{Binding ShowAddFormCommand}"/>
            <Button Content="+ Category" Width="100" Background="#8e44ad" Foreground="White"
                    FontWeight="SemiBold" Margin="8,0,0,0" Command="{Binding ShowAddCategoryCommand}"/>
            <Button Content="Clear Filters" Width="100" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="From" FontSize="11" Foreground="Gray"/>
                    <DatePicker SelectedDate="{Binding FilterDateFrom}" Width="130"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="To" FontSize="11" Foreground="Gray"/>
                    <DatePicker SelectedDate="{Binding FilterDateTo}" Width="130"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0" Width="160">
                    <TextBlock Text="Sponsor" FontSize="11" Foreground="Gray"/>
                    <ComboBox ItemsSource="{Binding Sponsors}" SelectedItem="{Binding FilterSponsor}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Width="160">
                    <TextBlock Text="Category" FontSize="11" Foreground="Gray"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <Button Content="Apply" Width="60" Margin="10,16,0,0" Background="#2980b9" Foreground="White"
                        Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Border>

        <!-- Add Form -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Record New Donation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,6"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                        <TextBlock Text="Date" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding NewDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                        <TextBlock Text="Sponsor *" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Sponsors}" SelectedItem="{Binding NewSponsor}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,6">
                        <TextBlock Text="Payment Method" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding NewPaymentMethod}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,6">
                        <TextBlock Text="Category *" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Program" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding NewProgram}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Amount *" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Receipt #" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewReceiptNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save Donation" Width="110" Background="#2980b9" Foreground="White"
                            Command="{Binding SaveDonationCommand}"/>
                    <Button Content="Cancel" Width="80" Margin="8,0,0,0"
                            Command="{Binding CancelAddCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Add Category Form -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                Visibility="{Binding IsAddingCategory, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Add Donation Category" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CategoryErrorMessage}" Foreground="Red" Margin="0,0,0,6"
                           Visibility="{Binding CategoryErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Category Name *" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Description" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewCategoryDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save Category" Width="110" Background="#8e44ad" Foreground="White"
                            Command="{Binding SaveCategoryCommand}"/>
                    <Button Content="Cancel" Width="80" Margin="8,0,0,0"
                            Command="{Binding CancelAddCategoryCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Donations List -->
        <ListView Grid.Row="3" ItemsSource="{Binding Donations}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Date" Width="90" DisplayMemberBinding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"/>
                    <GridViewColumn Header="Sponsor" Width="130" DisplayMemberBinding="{Binding Sponsor.Name}"/>
                    <GridViewColumn Header="Category" Width="100" DisplayMemberBinding="{Binding DonationCategory.Name}"/>
                    <GridViewColumn Header="Method" Width="70" DisplayMemberBinding="{Binding PaymentMethod}"/>
                    <GridViewColumn Header="Program" Width="100" DisplayMemberBinding="{Binding Program.Name}"/>
                    <GridViewColumn Header="Amount" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat={}{0:C}}" HorizontalAlignment="Right"
                                           FontWeight="SemiBold" Foreground="#27ae60"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Receipt #" Width="90" DisplayMemberBinding="{Binding ReceiptNumber}"/>
                    <GridViewColumn Header="Notes" Width="150" DisplayMemberBinding="{Binding Notes}"/>
                    <GridViewColumn Header="" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Del" Background="#c0392b" Foreground="White" Width="50"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.DeleteDonationCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>

<Window x:Class="Bookkeeping.Wpf.Views.ProgramDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:converters="clr-namespace:Bookkeeping.Wpf.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="650" Width="800"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header row: title + close button -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"
                       Foreground="#2c3e50" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✕ Close" Width="80" Height="32"
                    Background="#e74c3c" Foreground="White" FontWeight="SemiBold"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

        <!-- Period toggle -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Period:" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="#555" Margin="0,0,10,0"/>
            <Button Content="Current Month" Width="120" Height="30"
                    Command="{Binding ToggleMonthCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#ecf0f1"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCurrentMonth}" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Year to Date" Width="120" Height="30" Margin="5,0,0,0"
                    Command="{Binding ToggleYearCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#ecf0f1"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCurrentMonth}" Value="False">
                                <Setter Property="Background" Value="#2980b9"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Chart + summary badges -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="220"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chart -->
            <Border Grid.Row="0" Background="White" CornerRadius="8,8,0,0" Padding="10,10,10,0">
                <oxy:PlotView Model="{Binding ChartModel}"/>
            </Border>

            <!-- Summary numbers -->
            <Border Grid.Row="1" Background="White" CornerRadius="0,0,8,8" Padding="10,5,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#27ae60" CornerRadius="6" Padding="10,5" Margin="0,0,10,0"
                            Width="160">
                        <StackPanel>
                            <TextBlock Text="REVENUE" Foreground="White" FontSize="9" Opacity="0.8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:C}}"
                                       Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#c0392b" CornerRadius="6" Padding="10,5" Margin="0,0,10,0"
                            Width="160">
                        <StackPanel>
                            <TextBlock Text="EXPENSES" Foreground="White" FontSize="9" Opacity="0.8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalExpenses, StringFormat={}{0:C}}"
                                       Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="10,5" Width="160"
                            Background="{Binding NetAmountColor, Converter={StaticResource StringToBrushConverter}}">
                        <StackPanel>
                            <TextBlock Text="NET" Foreground="White" FontSize="9" Opacity="0.8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding NetAmount, StringFormat={}{0:C}}"
                                       Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Transactions list -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" Margin="0,5,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Transactions" FontSize="16" FontWeight="SemiBold"
                               Foreground="#2c3e50" Margin="0,0,0,4"/>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMoreTransactions}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="⚠ Showing most recent 500 transactions. Totals include the full period." Foreground="#e67e22" FontSize="11"/>
                        <Run Text=" Use Reports for full history." Foreground="#888" FontSize="11"/>
                    </TextBlock>
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Transactions}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Date" Width="95"
                                DisplayMemberBinding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"/>
                            <GridViewColumn Header="Type" Width="80"
                                DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="Description" Width="200"
                                DisplayMemberBinding="{Binding Description}"/>
                            <GridViewColumn Header="Program" Width="120"
                                DisplayMemberBinding="{Binding ProgramName}"/>
                            <GridViewColumn Header="Amount" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayAmount}"
                                                   Foreground="{Binding AmountColor, Converter={StaticResource StringToBrushConverter}}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="Bookkeeping.Wpf.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Bookkeeping.Wpf.Converters"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Expenses" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="+ Record Expense" Width="140" Background="#c0392b" Foreground="White"
                    FontWeight="SemiBold" Margin="20,0,0,0" Command="{Binding ShowAddFormCommand}"/>
            <Button Content="Clear Filters" Width="100" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#c0392b" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,0,6"/>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="From" FontSize="11" Foreground="Gray"/>
                    <DatePicker SelectedDate="{Binding FilterDateFrom}" Width="130"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="To" FontSize="11" Foreground="Gray"/>
                    <DatePicker SelectedDate="{Binding FilterDateTo}" Width="130"/>
                </StackPanel>
                <StackPanel Width="160">
                    <TextBlock Text="Program" FontSize="11" Foreground="Gray"/>
                    <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding FilterProgram}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <Button Content="Apply" Width="60" Margin="10,16,0,0" Background="#2980b9" Foreground="White"
                        Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Border>

        <!-- Add Form -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Record New Expense" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,6"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                        <TextBlock Text="Date" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding NewDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                        <TextBlock Text="Vendor *" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewVendorName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,6">
                        <TextBlock Text="Payment" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding NewPaymentMethod}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Program" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding NewProgram}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Amount *" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Receipt" FontWeight="SemiBold"/>
                        <Button Content="Browse..." Command="{Binding BrowseReceiptCommand}" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding NewReceiptPath, StringFormat='File: {0}'}" FontSize="11"
                           Foreground="Gray" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save Expense" Width="110" Background="#c0392b" Foreground="White"
                            Command="{Binding SaveExpenseCommand}"/>
                    <Button Content="Cancel" Width="80" Margin="8,0,0,0"
                            Command="{Binding CancelAddCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Expenses List -->
        <ListView Grid.Row="3" ItemsSource="{Binding Expenses}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Date" Width="90" DisplayMemberBinding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"/>
                    <GridViewColumn Header="Vendor" Width="130" DisplayMemberBinding="{Binding VendorName}"/>
                    <GridViewColumn Header="Method" Width="70" DisplayMemberBinding="{Binding PaymentMethod}"/>
                    <GridViewColumn Header="Program" Width="100" DisplayMemberBinding="{Binding Program.Name}"/>
                    <GridViewColumn Header="Amount" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat={}{0:C}}" HorizontalAlignment="Right"
                                           FontWeight="SemiBold" Foreground="#c0392b"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Receipt" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="View" Width="50"
                                        IsEnabled="{Binding ReceiptAttachmentPath, Converter={StaticResource StringToBoolConverter}}"
                                        CommandParameter="{Binding ReceiptAttachmentPath}"
                                        Command="{Binding DataContext.OpenReceiptCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Notes" Width="140" DisplayMemberBinding="{Binding Notes}"/>
                    <GridViewColumn Header="" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Del" Background="#c0392b" Foreground="White" Width="50"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Chk" Background="#8e44ad" Foreground="White" Width="50"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.PrintCheckCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>

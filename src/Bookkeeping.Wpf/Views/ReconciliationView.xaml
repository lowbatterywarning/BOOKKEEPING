<UserControl x:Class="Bookkeeping.Wpf.Views.ReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             Loaded="UserControl_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bank Reconciliation" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Balances -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Background="#e8f5e9" CornerRadius="6" Padding="10" Margin="0,0,10,6" Width="200">
                <StackPanel>
                    <TextBlock Text="LEDGER BALANCE" FontSize="10" Foreground="#2e7d32"/>
                    <TextBlock Text="{Binding LedgerBalance, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="#2e7d32"/>
                </StackPanel>
            </Border>
            <Border Background="#e3f2fd" CornerRadius="6" Padding="10" Margin="0,0,10,6" Width="200">
                <StackPanel>
                    <TextBlock Text="CLEARED ITEMS" FontSize="10" Foreground="#1565c0"/>
                    <TextBlock Text="{Binding ClearedBalance, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="#1565c0"/>
                </StackPanel>
            </Border>
            <Border Background="#fff3e0" CornerRadius="6" Padding="10" Margin="0,0,10,6" Width="200">
                <StackPanel>
                    <TextBlock Text="STATEMENT BALANCE" FontSize="10" Foreground="#e65100"/>
                    <TextBox Text="{Binding StatementBalance, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                             FontSize="18" FontWeight="Bold" Width="150" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            <Border Background="#ffebee" CornerRadius="6" Padding="10" Margin="0,0,10,6" Width="180">
                <StackPanel>
                    <TextBlock Text="DIFFERENCE" FontSize="10" Foreground="#c62828"/>
                    <TextBlock Text="{Binding Difference, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="#c62828"/>
                </StackPanel>
            </Border>
            <Button Content="✓ Complete Reconciliation" Width="170" Background="#27ae60" Foreground="White"
                    FontWeight="SemiBold" Margin="0,4,0,0" Command="{Binding CompleteReconciliationCommand}"
                    IsEnabled="{Binding IsReconciling, Converter={StaticResource InvertBoolConverter}}"/>
        </WrapPanel>

        <!-- Transactions -->
        <ListView Grid.Row="2" ItemsSource="{Binding BankTransactions}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Clear" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsCleared}" HorizontalAlignment="Center"
                                          Command="{Binding DataContext.ToggleClearCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Date" Width="90" DisplayMemberBinding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"/>
                    <GridViewColumn Header="Description" Width="300" DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Debit" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DebitAmount, StringFormat={}{0:N2}}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Credit" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CreditAmount, StringFormat={}{0:N2}}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- History -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="10" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Reconciliation History" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListView Grid.Row="1" ItemsSource="{Binding History}" MaxHeight="120">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Date" Width="100" DisplayMemberBinding="{Binding StatementDate, StringFormat={}{0:yyyy-MM-dd}}"/>
                            <GridViewColumn Header="Statement" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatementBalance, StringFormat={}{0:C}}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ledger" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LedgerBalance, StringFormat={}{0:C}}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Difference" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Difference, StringFormat={}{0:C}}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Notes" Width="150" DisplayMemberBinding="{Binding Notes}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>

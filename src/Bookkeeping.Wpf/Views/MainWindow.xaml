<Window x:Class="Bookkeeping.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Bookkeeping.Wpf.ViewModels"
        xmlns:views="clr-namespace:Bookkeeping.Wpf.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="1100"
        MinHeight="500" MinWidth="550"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SponsorsViewModel}">
            <views:SponsorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SponsorDashboardViewModel}">
            <views:SponsorDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncomeViewModel}">
            <views:IncomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
            <views:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
            <views:ProgramsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashBankViewModel}">
            <views:CashBankView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetViewModel}">
            <views:BudgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0" Background="#2c3e50">
            <StackPanel Margin="10">
                <TextBlock Text="BOOKKEEPING" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,20"/>

                <Button Content="Dashboard" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToDashboardCommand}"/>
                <Button Content="Sponsors" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToSponsorsCommand}"/>
                <Button Content="Sponsor Dashboard" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToSponsorDashboardCommand}"/>
                <Button Content="Revenue" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToIncomeCommand}"/>
                <Button Content="Expenses" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToExpensesCommand}"/>
                <Button Content="Programs" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToProgramsCommand}"/>
                <Button Content="Cash &amp; Bank" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToCashBankCommand}"/>
                <Button Content="Reports" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToReportsCommand}"/>

                <Button Content="Budget" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToBudgetCommand}"/>
                <Button Content="Search" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToSearchCommand}"/>

                <Separator Margin="0,20,0,10" Foreground="#7f8c8d"/>

                <Button Content="Settings" Style="{StaticResource NavButton}"
                        Background="#34495e" Foreground="White"
                        Command="{Binding NavigateToSettingsCommand}"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" Background="#ecf0f1">
            <ContentControl Content="{Binding CurrentView}" Margin="15"/>
        </Border>
    </Grid>
</Window>

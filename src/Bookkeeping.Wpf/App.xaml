<Application x:Class="Bookkeeping.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Bookkeeping.Wpf.Converters">
    <Application.Resources>
        <!-- Global converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
                <converters:ReportTypeVisibilityConverter x:Key="ReportTypeVisibilityConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>

        <!-- Global styles -->
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
        </Style>
    </Application.Resources>
</Application>
